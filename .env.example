DATABASE_URL=postgresql://user:password@host:5432/diginanba
DATABASE_SSL=true
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
# Optional protection for the payment webhook endpoint
PAYMENT_WEBHOOK_SECRET=replace-with-random-secret
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
# Must remain false until end-to-end test payments and secure download entitlements pass.
RAZORPAY_CHECKOUT_ENABLED=false
# Never use NEXT_PUBLIC_ for secrets.

# Private S3-compatible object storage for purchased product downloads (keep bucket private).
S3_ENDPOINT=https://replace-with-private-object-storage-endpoint
S3_BUCKET=replace-with-private-bucket
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret
