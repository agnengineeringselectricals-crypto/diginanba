DATABASE_URL=postgresql://user:password@host:5432/diginanba
DATABASE_SSL=true
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# Razorpay: keep secrets server-side; never prefix them with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-Razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-Razorpay-webhook-secret
# Keep false until test payments, webhook setup, refund flow, and secure download delivery are verified.
PAYMENTS_ENABLED=false

# Legacy internal webhook relay secret (not a substitute for Razorpay's native signature verification).
PAYMENT_WEBHOOK_SECRET=replace-with-random-secret
