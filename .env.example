DATABASE_URL=postgresql://user:password@host:5432/diginanba
DATABASE_SSL=true
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# Payments remain disabled until the owner explicitly activates production payments.
PAYMENT_PROVIDER=demo
PAYMENTS_LIVE=false

# Add only to a secure environment after merchant onboarding. Never commit secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# Optional development webhook protection for non-provider/demo integrations.
PAYMENT_WEBHOOK_SECRET=

# Never use NEXT_PUBLIC_ for payment or authentication secrets.
